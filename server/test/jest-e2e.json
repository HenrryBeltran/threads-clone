{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^generated/prisma/(.*)$": "<rootDir>/generated/prisma/$1",
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "globalSetup": "./test/setup.ts",
  "globalTeardown": "./test/setup.ts"
}
