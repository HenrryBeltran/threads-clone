generator client {
    provider     = "prisma-client"
    output       = "../generated/prisma"
    moduleFormat = "cjs"
}

datasource db {
    provider = "sqlite"
}

model activities {
    id                             String  @id
    sender                         String
    receiver                       String
    message                        String
    type                           String
    readStatus                     Int?    @default(dbgenerated("false")) @map("read_status")
    threadPostId                   String? @map("thread_post_id")
    createdAt                      String  @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt                      String  @default("CURRENT_TIMESTAMP") @map("updated_at")
    usersActivitiesReceiverToUsers users   @relation("activities_receiverTousers", fields: [receiver], references: [id], onDelete: Cascade, onUpdate: NoAction)
    usersActivitiesSenderToUsers   users   @relation("activities_senderTousers", fields: [sender], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model follows {
    id                          String @id
    userId                      String @map("user_id")
    targetId                    String @map("target_id")
    createdAt                   String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt                   String @default("CURRENT_TIMESTAMP") @map("updated_at")
    usersFollowsTargetIdToUsers users  @relation("follows_target_idTousers", fields: [targetId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    usersFollowsUserIdToUsers   users  @relation("follows_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model likes {
    id        String  @id
    likedPost String  @map("liked_post")
    userLike  String  @map("user_like")
    createdAt String  @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt String  @default("CURRENT_TIMESTAMP") @map("updated_at")
    users     users   @relation(fields: [userLike], references: [id], onDelete: Cascade, onUpdate: NoAction)
    threads   threads @relation(fields: [likedPost], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model reset_password {
    id        String @id
    email     String @unique(map: "reset_password_email_unique")
    token     String @unique(map: "reset_password_token_unique")
    expires   String
    createdAt String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt String @default("CURRENT_TIMESTAMP") @map("updated_at")
}

model search_history {
    id                                  String @id
    owner                               String
    userSearch                          String @map("user_search")
    createdAt                           String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt                           String @default("CURRENT_TIMESTAMP") @map("updated_at")
    usersSearchHistoryUserSearchToUsers users  @relation("search_history_user_searchTousers", fields: [userSearch], references: [id], onDelete: Cascade, onUpdate: NoAction)
    usersSearchHistoryOwnerToUsers      users  @relation("search_history_ownerTousers", fields: [owner], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model sessions {
    id        String @id
    token     String @unique(map: "sessions_token_unique")
    userId    String @map("user_id")
    expires   String
    createdAt String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt String @default("CURRENT_TIMESTAMP") @map("updated_at")
    users     users  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model threads {
    id           String  @id
    postId       String  @map("post_id")
    authorId     String  @map("author_id")
    rootId       String  @map("root_id")
    parentId     String? @map("parent_id")
    text         String
    resources    String?
    hashtags     String?
    mentions     String?
    likesCount   Int     @default(0) @map("likes_count")
    repliesCount Int     @default(0) @map("replies_count")
    createdAt    String  @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt    String  @default("CURRENT_TIMESTAMP") @map("updated_at")
    likes        likes[]
    users        users   @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
    id                                          String           @id
    email                                       String           @unique(map: "users_email_unique")
    username                                    String           @unique(map: "users_username_unique")
    password                                    String
    name                                        String
    bio                                         String
    link                                        String?
    profilePictureId                            String?          @map("profile_picture_id")
    roles                                       String           @default("user")
    followersCount                              Int              @default(0) @map("followers_count")
    followingsCount                             Int              @default(0) @map("followings_count")
    emailVerified                               String?          @map("email_verified")
    createdAt                                   String           @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt                                   String           @default("CURRENT_TIMESTAMP") @map("updated_at")
    activitiesActivitiesReceiverToUsers         activities[]     @relation("activities_receiverTousers")
    activitiesActivitiesSenderToUsers           activities[]     @relation("activities_senderTousers")
    followsFollowsTargetIdToUsers               follows[]        @relation("follows_target_idTousers")
    followsFollowsUserIdToUsers                 follows[]        @relation("follows_user_idTousers")
    likes                                       likes[]
    searchHistorySearchHistoryUserSearchToUsers search_history[] @relation("search_history_user_searchTousers")
    searchHistorySearchHistoryOwnerToUsers      search_history[] @relation("search_history_ownerTousers")
    sessions                                    sessions[]
    threads                                     threads[]
}

model verify_email {
    id        String @id
    newEmail  String @map("new_email")
    token     String @unique(map: "verify_email_token_unique")
    expires   String
    createdAt String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt String @default("CURRENT_TIMESTAMP") @map("updated_at")
    oldEmail  String @map("old_email")
}

model verify_user {
    id        String @id
    email     String @unique(map: "verify_user_email_unique")
    token     String @unique(map: "verify_user_token_unique")
    code      String
    expires   String
    createdAt String @default("CURRENT_TIMESTAMP") @map("created_at")
    updatedAt String @default("CURRENT_TIMESTAMP") @map("updated_at")
}
